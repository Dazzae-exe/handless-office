NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Nombres de tablas, vistas y bucket en Supabase (opcionales).
# Si se dejan vacías se usan los valores por defecto indicados.
# Se incrustan en el bundle al compilar: cambiarlas exige reconstruir (pnpm build).
NEXT_PUBLIC_SUPABASE_POSTS_TABLE=posts
NEXT_PUBLIC_SUPABASE_PROJECTS_TABLE=projects
NEXT_PUBLIC_SUPABASE_IMAGES_TABLE=images
# Prefijo de las vistas: <prefijo>summary, <prefijo>daily, <prefijo>top_posts, <prefijo>top_projects.
NEXT_PUBLIC_SUPABASE_ANALYTICS_PREFIX=analytics_
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=tiptap_content

NEXT_PUBLIC_APP_NAME=Blog Dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000
